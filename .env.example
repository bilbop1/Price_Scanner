# === Market Edge Scanner v2.0 Configuration ===

# Odds-API.io – https://docs.odds-api.io
# Sign up at https://odds-api.io to get your API key
ODDS_API_KEY=

# Legacy: THE_ODDS_API_KEY also works as a fallback
# THE_ODDS_API_KEY=

# Polymarket – no key required for public endpoints
# CLOB API base: https://clob.polymarket.com
# Gamma API base: https://gamma-api.polymarket.com

# Kalshi – no key required for public market data
# API base: https://api.elections.kalshi.com/trade-api/v2

# ── Telegram Alerts ─────────────────────────────────────────────
# Get a bot token from @BotFather on Telegram
# Get your chat ID by messaging @userinfobot
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_ALERT_EDGE=0.07
TELEGRAM_ENABLED=true

# ── Edge calculation ────────────────────────────────────────────
FEE_BUFFER=0.03
MIN_EDGE=0.02
MIN_BOOKS=2
MATCH_CONFIDENCE_THRESHOLD=92

# ── Polling (24/7 autonomous scanning) ─────────────────────────
# Base interval when no live games
POLL_INTERVAL_SECONDS=30
# Faster interval when live games detected
LIVE_POLL_INTERVAL_SECONDS=15

# ── Server ──────────────────────────────────────────────────────
BACKEND_PORT=8000
FRONTEND_PORT=5173
